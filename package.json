{
  "name": "@rivium/sync-node",
  "version": "0.1.0",
  "description": "RiviumSync Node.js SDK - Server-side SDK for RiviumSync Realtime Database",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "riviumsync",
    "realtime",
    "database",
    "firebase",
    "mqtt",
    "sync",
    "nodejs",
    "backend",
    "admin",
    "sdk"
  ],
  "author": "Rivium",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rivium-co/rivium-sync-node-sdk.git"
  },
  "homepage": "https://rivium.co/",
  "bugs": {
    "url": "https://github.com/Rivium-co/rivium-sync-node-sdk/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "mqtt": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
